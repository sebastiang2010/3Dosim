%% 
A=nan(512,512,171); 

A(47:47+199,49:49+199,1:127)=PET; 

 figure(102)
 for nCT=1:sCT(3)
 
     cla
     %zCT=nCT*dzCT/2; %mm  
     %nPET=zCT/dzPET*2; 
     %nPET1=round(nPET); 
     %a=double(CT(:,:,nCT)); 
     %b=PET(:,:,nPET1);
 
     ax1 = axes;
     imshow(a ./ max(a(:)), 'Parent', ax1);  
     hold on
     ax2 = axes;     
     h = imshow(A(:,:), 'Parent', ax2);  % Mostrar PET en su sistema de referencia
     set(ax2, 'Color', 'none');  % Hacer transparente el fondo de ax2
     set(h, 'AlphaData', 0.5);  % Ajustar transparencia de la imagen PET
     colormap(ax2, jet);
     %colorbar(ax2);  % Agregar una barra de color solo para la imagen PET (opcional)
     %linkaxes([ax1, ax2],'xy');
     axis(ax1, 'off');   % Mostrar ejes si quieres visualizar las coordenadas
     clim(ax2, [0 max_PET]);
     pause(1)
 end 

